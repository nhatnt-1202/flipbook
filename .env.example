NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chỉ dùng cho "npm run db:setup" (tạo bảng). KHÔNG thêm tiền tố NEXT_PUBLIC_.
# Dashboard → Connect → Connection string (Session pooler), thay [YOUR-PASSWORD] bằng mật khẩu DB.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Tài khoản root duy nhất (đăng nhập trang chủ để upload/xóa). Chạy "npm run db:setup" để tạo hoặc đổi mật khẩu.
ROOT_EMAIL=
ROOT_PASSWORD=
